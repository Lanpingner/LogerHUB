# Copy to .env and fill in. Both secrets must be long random strings:
#   openssl rand -hex 32
CONSOLE_SECRET=
SESSION_SECRET=

# The domain Caddy should serve and get a certificate for. Use `localhost` for
# local runs (Caddy issues an internal certificate).
LOGGUBER_DOMAIN=localhost

# Number of reverse proxies in front of the gateway. Your nginx is 1;
# add one for each extra hop such as Cloudflare.
TRUSTED_PROXY_HOPS=1

# Where the containers publish, for your reverse proxy to reach. Change the
# port if something already uses it on the host.
INGEST_BIND=127.0.0.1:8080
WEB_BIND=127.0.0.1:3000
