{
  "name": "@leviathan.systems/logerhub-client",
  "version": "0.1.1",
  "description": "Streams Express and WebSocket logs to a LogerHUB gateway over WebSocket, spooling to local SQLite while it is unreachable.",
  "keywords": [
    "logging",
    "logger",
    "express",
    "express-middleware",
    "websocket",
    "ws",
    "observability",
    "loki",
    "structured-logging",
    "redaction",
    "sqlite"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Lanpingner/LogerHUB/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lanpingner/LogerHUB.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/Lanpingner/LogerHUB/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-dts.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && node scripts/check-publish.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express4": "npm:@types/express@^4.17.25",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express4": "npm:express@^4.22.3",
    "supertest": "^7.3.2",
    "@logguber/shared": "*"
  }
}
